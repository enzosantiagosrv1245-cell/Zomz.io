import java.awt.Color;
import java.awt.Dimension;
import java.awt.Graphics;
import java.awt.Graphics2D;
import java.awt.RenderingHints;
import java.awt.event.MouseEvent;
import java.awt.event.MouseListener;
import java.awt.event.MouseMotionListener;
import java.util.HashMap;
import java.util.Map;
import javax.swing.JFrame;
import javax.swing.JPanel;
import javax.swing.SwingUtilities;

public class MobileTouchController extends JPanel implements MouseListener, MouseMotionListener {

    // ==========================================
    // 1. Virtual Joystick Class
    // ==========================================
    public static class VirtualJoystick {
        private final float centerX, centerY;
        private final float radius;
        private final float knobRadius;

        private float knobX, knobY;
        private int activePointerId = -1;
        private boolean isPressed = false;

        private float deltaX = 0f; // Range: -1.0 to 1.0
        private float deltaY = 0f; // Range: -1.0 to 1.0

        public VirtualJoystick(float centerX, float centerY, float radius, float knobRadius) {
            this.centerX = centerX;
            this.centerY = centerY;
            this.radius = radius;
            this.knobRadius = knobRadius;
            this.knobX = centerX;
            this.knobY = centerY;
        }

        public boolean touchDown(float touchX, float touchY, int pointerId) {
            if (isPressed) return false;

            float dx = touchX - centerX;
            float dy = touchY - centerY;

            // Check if touch is within joystick boundary
            if ((dx * dx + dy * dy) <= (radius * radius)) {
                activePointerId = pointerId;
                isPressed = true;
                updateKnob(touchX, touchY);
                return true;
            }
            return false;
        }

        public void touchDragged(float touchX, float touchY, int pointerId) {
            if (isPressed && pointerId == activePointerId) {
                updateKnob(touchX, touchY);
            }
        }

        public void touchUp(int pointerId) {
            if (isPressed && pointerId == activePointerId) {
                isPressed = false;
                activePointerId = -1;
                knobX = centerX;
                knobY = centerY;
                deltaX = 0f;
                deltaY = 0f;
            }
        }

        private void updateKnob(float touchX, float touchY) {
            float dx = touchX - centerX;
            float dy = touchY - centerY;
            float distance = (float) Math.sqrt(dx * dx + dy * dy);

            if (distance <= radius) {
                knobX = touchX;
                knobY = touchY;
            } else {
                knobX = centerX + (dx / distance) * radius;
                knobY = centerY + (dy / distance) * radius;
            }

            deltaX = (knobX - centerX) / radius;
            deltaY = (knobY - centerY) / radius;
        }

        public void draw(Graphics2D g) {
            // Outer Ring
            g.setColor(new Color(255, 255, 255, 50));
            g.fillOval((int)(centerX - radius), (int)(centerY - radius), (int)(radius * 2), (int)(radius * 2));
            g.setColor(new Color(255, 255, 255, 180));
            g.drawOval((int)(centerX - radius), (int)(centerY - radius), (int)(radius * 2), (int)(radius * 2));

            // Inner Knob
            g.setColor(new Color(255, 255, 255, 180));
            g.fillOval((int)(knobX - knobRadius), (int)(knobY - knobRadius), (int)(knobRadius * 2), (int)(knobRadius * 2));
        }

        public float getDeltaX() { return deltaX; }
        public float getDeltaY() { return deltaY; }
        public boolean isPressed() { return isPressed; }
    }

    // ==========================================
    // 2. Controller State & Inputs
    // ==========================================
    private final VirtualJoystick moveJoystick;
    private final VirtualJoystick lookJoystick;
    private final Map<Integer, TouchPoint> activeTouches = new HashMap<>();

    // Demo Player Variables
    private float playerX = 400;
    private float playerY = 300;
    private float playerAngle = 0;

    private static class TouchPoint {
        float x, y;
        TouchPoint(float x, float y) { this.x = x; this.y = y; }
    }

    public MobileTouchController(int width, int height) {
        setPreferredSize(new Dimension(width, height));
        setBackground(new Color(30, 30, 30));

        float radius = 90f;
        float knobRadius = 35f;
        float margin = 140f;

        // Left Joystick -> Move
        moveJoystick = new VirtualJoystick(margin, height - margin, radius, knobRadius);
        // Right Joystick -> Look/Aim
        lookJoystick = new VirtualJoystick(width - margin, height - margin, radius, knobRadius);

        addMouseListener(this);
        addMouseMotionListener(this);
    }

    // --- Multi-Touch Interface Methods ---
    public void onTouchDown(int pointerId, float x, float y) {
        activeTouches.put(pointerId, new TouchPoint(x, y));
        if (!moveJoystick.touchDown(x, y, pointerId)) {
            lookJoystick.touchDown(x, y, pointerId);
        }
    }

    public void onTouchMove(int pointerId, float x, float y) {
        TouchPoint point = activeTouches.get(pointerId);
        if (point != null) {
            point.x = x;
            point.y = y;
            moveJoystick.touchDragged(x, y, pointerId);
            lookJoystick.touchDragged(x, y, pointerId);
        }
    }

    public void onTouchUp(int pointerId) {
        activeTouches.remove(pointerId);
        moveJoystick.touchUp(pointerId);
        lookJoystick.touchUp(pointerId);
    }

    // Getters for player control logic
    public float getMoveX() { return moveJoystick.getDeltaX(); }
    public float getMoveY() { return moveJoystick.getDeltaY(); }
    public float getLookAngleDegrees() {
        if (!lookJoystick.isPressed()) return playerAngle;
        double radians = Math.atan2(lookJoystick.getDeltaY(), lookJoystick.getDeltaX());
        return (float) Math.toDegrees(radians);
    }

    // ==========================================
    // 3. Rendering and Update Loop
    // ==========================================
    public void updateGame(float speed) {
        // Apply movement vector
        playerX += getMoveX() * speed;
        playerY += getMoveY() * speed;

        // Update rotation angle if look joystick is touched
        if (lookJoystick.isPressed()) {
            playerAngle = getLookAngleDegrees();
        }
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Update demo game state
        updateGame(4.0f);

        // Draw Player (Triangle indicating rotation)
        g2.setColor(Color.CYAN);
        g2.translate(playerX, playerY);
        g2.rotate(Math.toRadians(playerAngle));
        int[] xPoints = {20, -10, -10};
        int[] yPoints = {0, -10, 10};
        g2.fillPolygon(xPoints, yPoints, 3);
        g2.rotate(-Math.toRadians(playerAngle));
        g2.translate(-playerX, -playerY);

        // Render UI Joysticks
        moveJoystick.draw(g2);
        lookJoystick.draw(g2);

        // Trigger next frame
        repaint();
    }

    // --- Standard Mouse Event Listeners (Simulates Pointer ID = 0 for Testing) ---
    @Override public void mousePressed(MouseEvent e) { onTouchDown(0, e.getX(), e.getY()); }
    @Override public void mouseDragged(MouseEvent e) { onTouchMove(0, e.getX(), e.getY()); }
    @Override public void mouseReleased(MouseEvent e) { onTouchUp(0); }
    @Override public void mouseMoved(MouseEvent e) {}
    @Override public void mouseClicked(MouseEvent e) {}
    @Override public void mouseEntered(MouseEvent e) {}
    @Override public void mouseExited(MouseEvent e) {}

    // ==========================================
    // 4. Main Executable Entry Point
    // ==========================================
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Mobile Dual-Joystick Controller");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.add(new MobileTouchController(800, 600));
            frame.pack();
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
        });
    }
}
